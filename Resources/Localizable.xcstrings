    "Requested: %@. Selected for this translation: %@.\n%@ → %@: the requested strategy does not support this language pair.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested: %@. Selected for this translation: %@.\n%@ → %@: the requested strategy does not support this language pair."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청한 방식: %@ · 이번 번역 방식: %@\n%@ → %@는 요청한 방식에서 지원하지 않아 다른 방식을 사용했어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定した方式：%@。今回の翻訳方式：%@。\n%@ → %@は指定した方式でサポートされていないため、別の方式を使用しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求的方式：%@。本次翻译使用：%@。\n%@ → %@ 不受请求的方式支持，因此使用了其他方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要求的方式：%@。本次翻譯使用：%@。\n%@ → %@ 不受要求的方式支援，因此使用了其他方式。"
          }
        }
      }
    },
    "Requested: %@. Selected for this translation: %@.\n%@ → %@: the requested model is not installed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested: %@. Selected for this translation: %@.\n%@ → %@: the requested model is not installed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청한 방식: %@ · 이번 번역 방식: %@\n%@ → %@의 요청한 모델이 설치되어 있지 않아 다른 방식을 사용했어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定した方式：%@。今回の翻訳方式：%@。\n%@ → %@の指定モデルがインストールされていないため、別の方式を使用しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求的方式：%@。本次翻译使用：%@。\n%@ → %@ 所需的模型尚未安装，因此使用了其他方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
