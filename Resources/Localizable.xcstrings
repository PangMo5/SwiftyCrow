{
  "sourceLanguage": "en",
  "strings": {
    "%@ (%@)": {
      "comment": "Toolbar help: localized action name followed by its keyboard shortcut.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@）"
          }
        }
      }
    },
    "1. Open Language & Region below.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Open Language & Region below."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 아래 버튼으로 ‘언어 및 지역’을 열어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 下のボタンから『言語と地域』を開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 点击下方按钮打开“语言与地区”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 點選下方按鈕開啟「語言與地區」。"
          }
        }
      }
    },
    "2. Choose Translation Languages at the bottom.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Choose Translation Languages at the bottom."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 화면 아래쪽에서 ‘번역 언어’를 선택해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 画面下部の『翻訳言語』を選びます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 在页面底部选择“翻译语言”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 在頁面底部選擇「翻譯語言」。"
          }
        }
      }
    },
    "3. Download both languages, then return here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Download both languages, then return here."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 두 언어를 다운로드하고 이 창으로 돌아오세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 両方の言語をダウンロードして、この画面に戻ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 下载两种语言，然后返回此窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 下載兩種語言，然後返回此視窗。"
          }
        }
      }
    },
    "About": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftyCrowについて"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정보"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於"
          }
        }
      }
    },
    "Active only while a capture result window is focused.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active only while a capture result window is focused."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャ結果のウインドウを選択しているときに使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처 결과 창이 선택되어 있을 때 사용할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在截图结果窗口处于活动状态时可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在擷取結果視窗作用中時可用。"
          }
        }
      }
    },
    "Add the required language model in System Settings → General → Language & Region → Translation Languages, then capture again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the required language model in System Settings → General → Language & Region → Translation Languages, then capture again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → 一般 → 言語と地域 → 翻訳言語で必要なモデルをダウンロードしてから、もう一度キャプチャしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 일반 → 언어 및 지역 → 번역 언어에서 필요한 모델을 다운로드한 뒤 다시 캡처해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置 → 通用 → 语言与地区 → 翻译语言中下载所需模型，然后重新截图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定 → 一般 → 語言與地區 → 翻譯語言中下載所需模型，再重新擷取。"
          }
        }
      }
    },
    "Allow screen access and choose the language you want to read.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow screen access and choose the language you want to read."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 기록을 허용하고 읽고 싶은 언어를 골라주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録を許可し、読みたい言語を選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许屏幕录制，并选择要阅读的语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許螢幕錄製，並選擇要閱讀的語言。"
          }
        }
      }
    },
