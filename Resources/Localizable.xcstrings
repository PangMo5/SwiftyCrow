    "Better recognition, clearer translated layouts, and smoother capture and live translation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Better recognition, clearer translated layouts, and smoother capture and live translation."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자 인식부터 번역 배치까지 다듬었어요. 캡처와 실시간 번역을 더 편하게 사용해 보세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字の読み取りから訳文の配置まで改善。キャプチャとライブ翻訳がさらに使いやすくなりました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改善文字识别和译文布局，让截图与实时翻译更顺畅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改善文字辨識與譯文配置，讓擷取與即時翻譯更順暢。"
          }
        }
      }
    },
