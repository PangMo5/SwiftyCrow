    "Download the languages you want to translate from and into. For English → Korean, download both English and Korean.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download the languages you want to translate from and into. For English → Korean, download both English and Korean."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역할 원문의 언어와 읽을 언어를 모두 받아주세요. 예를 들어 영어를 한국어로 읽으려면 영어와 한국어가 필요해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原文の言語と翻訳先の言語を両方ダウンロードしてください。たとえば英語を韓国語で読むには、英語と韓国語が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请下载原文语言和译文语言。例如，将英语翻译成韩语时，需要同时下载英语和韩语。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請下載原文語言和譯文語言。例如，將英文翻譯成韓文時，需要同時下載英文和韓文。"
          }
        }
      }
    },
