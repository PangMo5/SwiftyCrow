        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 방식: %@ · %@ → %@. 선택한 방식의 모델이 설치되어 있지 않아요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で%@ → %@を翻訳しています。優先するモデルはインストールされていません。"
