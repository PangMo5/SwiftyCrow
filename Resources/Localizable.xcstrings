    "SwiftyCrow checks in the background and notifies you when a new version is available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftyCrow checks in the background and notifies you when a new version is available."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftyCrowはバックグラウンドで新しいバージョンを確認し、お知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 버전이 나오면 SwiftyCrow가 백그라운드에서 확인하고 알려드려요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftyCrow 会在后台检查新版本，并在有更新时通知你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftyCrow 會在背景檢查新版本，並在有更新時通知你。"
          }
        }
      }
    },
    "SwiftyCrow stays at the top of your screen, ready whenever you need it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
