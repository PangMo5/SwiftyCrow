          }
        }
      }
    },
    "Click the menu bar icon and choose Capture translation. Drag over text, or press Space to select a whole window.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the menu bar icon and choose Capture translation. Drag over text, or press Space to select a whole window."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 아이콘을 눌러 캡처 번역을 선택하세요. 글 위를 드래그하거나 Space를 눌러 창 전체를 고를 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのアイコンをクリックし、キャプチャ翻訳を選びます。文字の上をドラッグするか、Spaceキーでウインドウ全体を選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击菜单栏图标并选择截图翻译。拖过文字，或按空格键选择整个窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選選單列圖示並選擇擷取翻譯。拖曳文字範圍，或按空白鍵選取整個視窗。"
          }
        }
      }
    },
