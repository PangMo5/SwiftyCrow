    "Choose an area once. Keep translating the text inside as it changes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an area once. Keep translating the text inside as it changes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역을 한 번 지정하면, 그 안의 글이 바뀔 때마다 이어서 번역해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲を一度選ぶだけ。その中の文字が変わるたびに翻訳を続けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选定一次区域，其中的文字变化时就会继续翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選定一次區域，其中的文字變化時就會繼續翻譯。"
          }
        }
      }
    },
    "Clear shortcut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
