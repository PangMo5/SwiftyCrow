    "Granted. Capture and live translation can read the selected screen area.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Granted. Capture and live translation can read the selected screen area."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용됨. 선택한 화면의 글을 캡처하고 실시간으로 번역할 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可済みです。選んだ画面範囲をキャプチャし、ライブ翻訳で読み取れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许。可以截取所选屏幕区域，也可以使用实时翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已允許。可以擷取所選螢幕區域，也可以使用即時翻譯。"
          }
        }
      }
    },
