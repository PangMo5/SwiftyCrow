    "Some text may be misread. Compare the translation with the original.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some text may be misread. Compare the translation with the original."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の文字を読み違えている可能性があります。訳文を原文と比べてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 글자를 잘못 읽었을 수 있어요. 번역문을 원문과 비교해 주세요."
          }
        },
        "zh-Hans": {
