    "Improved recognition for vertical text, ruby annotations, rotated text, and printed dialogue. Review indicators help you spot uncertain results.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Improved recognition for vertical text, ruby annotations, rotated text, and printed dialogue. Review indicators help you spot uncertain results."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세로쓰기, 후리가나, 기울어진 글자와 말풍선 속 대사를 더 정확하게 인식해요. 불확실한 결과는 검토 표시로 알려드려요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦書き、ふりがな、傾いた文字、印刷された吹き出しの読み取りを改善。不確かな結果には確認の目印が付きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改善竖排文字、注音小字、倾斜文字和印刷对话的识别，并标记不确定的结果以便检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改善直排文字、注音小字、傾斜文字與印刷對話的辨識，並標記不確定的結果以便檢查。"
          }
        }
      }
    },
    "Keep paragraphs, lists, labels, text styles, and alignment closer to the source. Vertical text is laid out for the language you read.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep paragraphs, lists, labels, text styles, and alignment closer to the source. Vertical text is laid out for the language you read."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문단, 목록, 짧은 안내 문구의 배치와 글자 스타일을 원문에 가깝게 유지해요. 세로 글도 번역할 언어에 맞는 방향으로 보여줘요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "段落、リスト、ラベルの配置や文字のスタイルを原文に近く保ちます。縦書きも翻訳先の言語に合った方向で表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让段落、列表、标签的布局、文字样式和对齐更接近原文。竖排文字也会按译文语言适合的方向排列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓段落、清單、標籤的配置、文字樣式與對齊更接近原文。直排文字也會依譯文語言適合的方向排列。"
          }
        }
      }
    },
    "Keep reading as the screen changes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep reading as the screen changes"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
