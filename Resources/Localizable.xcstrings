    "You can finish setup now and allow screen access before your first capture.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can finish setup now and allow screen access before your first capture."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 안내를 마치고, 첫 캡처 전에 화면 기록을 허용해도 괜찮아요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今は案内を終え、最初のキャプチャの前に画面収録を許可しても構いません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以先完成设置，在首次截图前再允许屏幕录制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以先完成設定，在首次擷取前再允許螢幕錄製。"
          }
        }
      }
    },
    "Your next translation is in the menu bar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next translation is in the menu bar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요할 때, 메뉴 막대에서 만나요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳したくなったら、メニューバーへ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
